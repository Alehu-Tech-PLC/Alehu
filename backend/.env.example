# ── Required in production (set these as Vercel environment variables) ────────

# PostgreSQL connection string — use Neon, Supabase, or Railway free tier
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Strong random secrets — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-secret-key-here
JWT_SECRET_KEY=your-strong-jwt-secret-key-here

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Optional: preshared key for wearable device ingest
DEVICE_INGEST_KEY=your-device-ingest-key

# ── Local development only ────────────────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=development
